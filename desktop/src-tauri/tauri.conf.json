{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chamber",
  "version": "0.3.1",
  "identifier": "com.turalearn.chamber",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run build",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "devUrl": "http://127.0.0.1:7878",
    "frontendDist": "../../board"
  },
  "app": {
    "windows": [
      {
        "title": "Chamber",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../../bin": "app/bin",
      "../../lib": "app/lib",
      "../../board": "app/board",
      "../../package.json": "app/package.json",
      "../../relay/src": "app/relay/src",
      "../../relay/wrangler.toml": "app/relay/wrangler.toml",
      "../../relay/package.json": "app/relay/package.json",
      "../../relay/node_modules": "app/relay/node_modules"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzNkQwQzczNDQ5RjhCODgKUldTSWk1OUVjd3h0azMvR2VkVHIwZEVUVXFDNDNZcCt5QlF1T1RJcHFqMHB2TnlpUXk0bDhBeC8K",
      "endpoints": [
        "https://github.com/tura-learn/chamber/releases/latest/download/latest.json"
      ]
    }
  }
}
