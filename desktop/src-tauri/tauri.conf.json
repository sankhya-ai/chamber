{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chamber",
  "version": "0.2.0",
  "identifier": "com.turalearn.chamber",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run build",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "devUrl": "http://127.0.0.1:7878",
    "frontendDist": "../../board"
  },
  "app": {
    "windows": [
      {
        "title": "Chamber",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
